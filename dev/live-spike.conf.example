# Spike 2026-11-06 (wisera, MailHub's Dovecot): provider mailboxes as live IMAP folders
# (imapc) under Live/, and Cypht-style combined views under Virtual/ (virtual plugin).
# Installed as /srv/vmail/live-spike.conf (uid 1000, 0600), included by a line appended
# to dovecot/mailhub.conf:  !include_try /srv/vmail/live-spike.conf
# (mailhub.conf is re-rendered on every app update, which drops that line.)
# Each virtual folder is a directory under ~/virtual/<name>/ holding a dovecot-virtual
# file; Dovecot's wildcards do not reach the imapc namespace, so folders are listed by name.
# Findings: see spike-notes.md, "Live and virtual folders in Roundcube".
# SPIKE: each provider account as a live IMAP folder tree under Live/, and
# combined views under Virtual/ (Dovecot virtual plugin), Cypht-style.
mail_plugins {
  virtual = yes
  # full-text search off: with it, a SEARCH in a live folder downloads and
  # indexes the whole remote mailbox (2.4 has no per-namespace switch)
  fts = no
  fts_flatcurve = no
}
namespace live_contact {
  prefix = Live/contact@aptero.co/
  separator = /
  mail_driver = imapc
  mailbox_list_layout = imapc
  mail_path = ~/imapc/contact
  imapc_host = mail.privateemail.com
  imapc_port = 993
  imapc_ssl = imaps
  imapc_user = contact@aptero.co
  ssl_client_ca_dir = /etc/ssl/certs
  list = yes
  subscriptions = no
  imapc_password = <the provider password>
}
namespace virtual {
  prefix = Virtual/
  separator = /
  mail_driver = virtual
  mailbox_list_layout = fs
  mail_path = ~/virtual
  list = yes
  subscriptions = no
}
